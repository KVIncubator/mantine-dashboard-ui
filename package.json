    "@mantine/hooks": "^7.7.1",
    "@mantine/modals": "^7.12.2",
    "@reduxjs/toolkit": "^2.5.1",
    "@tabler/icons-react": "^3.30.0",
    "axios": "^1.7.9",
    "dayjs": "^1.11.10",
    "i18next": "^24.2.2",
