    "react-dom": "^18.2.0",
    "react-i18next": "^15.4.1",
    "react-lottie": "^1.2.10",
    "react-redux": "^9.2.0",
    "react-router-dom": "^7.2.0",
    "recharts": "2",
    "redux": "^5.0.1",
    "redux-persist": "^6.0.0",
    "yup": "^1.6.1"
